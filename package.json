{
  "name": "goldbox-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reads SSI Gold Box game data files and renders their dungeons in 3D in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "inspect": "tsx src/cli/inspect.ts",
    "dump": "tsx src/cli/dump.ts"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/three": "^0.169.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.11"
  }
}
